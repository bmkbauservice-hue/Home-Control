<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b10e47d4-d4f2-44f2-8fbb-5e1249af4daf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fest auf 1.0.9 (keine offizielle Blink-API, siehe docs/BLINK.md): ein automatisches
         Update könnte die inoffiziellen Endpunkte unbemerkt ändern. -->
    <PackageReference Include="Blink.NET" Version="1.0.9" />
    <!-- Prüft das Access Token (JWT) im Header "Authorization: Bearer ...". -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>

</Project>

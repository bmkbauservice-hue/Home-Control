{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=homecontrol.db"
  },
  "SeedDemoData": false,
  "Auth": {
    "RequireLoginForReading": false
  },
  "Jwt": {
    "Issuer": "HomeControl",
    "Audience": "HomeControl",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Tuya": {
    "BaseUrl": "https://openapi.tuyaeu.com",
    "AutoSyncSeconds": 900
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Tuya": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}

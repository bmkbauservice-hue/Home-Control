# Vorlage für .env (Docker Compose). Kopieren:  cp .env.example .env   und dann die Werte eintragen.
# .env steht in .gitignore und .dockerignore: Sie kommt nie ins Repo und nie ins Image.
# Namen mit "__" sind Einstellungen von ASP.NET Core ("Jwt__SigningKey" = Jwt:SigningKey).
# Erklärung: docs/DOCKER.md

# Welche Dienste "docker compose up" startet. Die Demo startet man mit --profile demo.
COMPOSE_PROFILES=betrieb

# Port auf diesem Rechner (nur 127.0.0.1). Der Dienst auf dem PC benutzt 5200, die Demo 5300.
HC_PORT=5400
# Mit Sensor-Gateway: COMPOSE_PROFILES=betrieb,sensoren. USB-Weiterleitung auf diesen Port.
HC_SENSOR_PORT=5391

# Pflicht: Signaturschlüssel für die Anmelde-Tokens, mindestens 32 Zeichen. Erzeugen z. B. mit:
#   head -c 48 /dev/urandom | base64 | tr -d '\n'      (läuft unter Linux und macOS)
Jwt__SigningKey=

# Lesen nur mit Anmeldung (empfohlen). Der KI-Agent braucht dann einen Schlüssel:
Auth__RequireLoginForReading=true
Agent__ApiKey=

# Raumklima: liegt dauerhaft im Daten-Volume. Den vorhandenen Bridge-Schlüssel lokal übernehmen.
Climate__DatabasePath=/data/homecontrol-climate.db
SensorBridge__Key=

# Tuya-Cloud (nur lesend). Leer = Tuya nicht eingerichtet.
Tuya__ClientId=
Tuya__ClientSecret=
Tuya__TestDeviceId=

# Blink: standardmäßig AUS. Wichtig: Blink erlaubt nur EINE Stelle, die das Token erneuert. Läuft der Dienst
# auf dem PC schon mit Blink, würden sich beide gegenseitig abmelden. Erst einschalten, wenn der Container
# den Dienst ersetzt (docs/DOCKER.md, "Umzug").
Blink__Enabled=false
Blink__HardwareId=
Blink__InitialRefreshToken=
# Optionaler HTTP-Proxy nur für Blink. Leer lassen, wenn Blink direkt erreichbar ist.
Blink__ProxyUrl=


